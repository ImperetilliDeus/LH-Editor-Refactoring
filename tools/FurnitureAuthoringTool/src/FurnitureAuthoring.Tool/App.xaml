<Application x:Class="FurnitureAuthoring.Tool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF4EFE6" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFBF5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF234B44" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFD7E4D9" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE0D5C3" />
    </Application.Resources>
</Application>
