<Window x:Class="FurnitureAuthoring.Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FurnitureAuthoring.Contracts.Models;assembly=FurnitureAuthoring.Contracts"
        mc:Ignorable="d"
        Title="가구 저작 도구"
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="820"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="18" LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,16"
                Padding="18"
                CornerRadius="14"
                Background="{StaticResource AccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="가구 저작 도구" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FFF1F4EE"
                               Text="가구 패치 메타데이터, 프리셋 기본값, defects를 편집합니다." />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FFD7E4D9"
                               Text="{Binding CurrentFilePath, StringFormat=현재 파일: {0}}" />
                </StackPanel>
                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Top">
                    <Button Margin="0,0,8,8" Padding="14,8" Click="NewManifest_Click" Content="새 매니페스트" />
                    <Button Margin="0,0,8,8" Padding="14,8" Click="LoadSample_Click" Content="샘플 불러오기" />
                    <Button Margin="0,0,8,8" Padding="14,8" Click="OpenManifest_Click" Content="열기" />
                    <Button Margin="0,0,8,8" Padding="14,8" Click="SaveManifest_Click" Content="저장" />
                    <Button Margin="0,0,8,8" Padding="14,8" Click="SaveManifestAs_Click" Content="다른 이름으로 저장" />
                    <Button Margin="0,0,8,8" Padding="14,8" Click="ValidateManifest_Click" Content="검증" />
                    <Button Margin="0,0,0,8" Padding="14,8" Click="PatchBuild_Click" Content="패치 빌드" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12"
                CornerRadius="10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <DockPanel>
                <TextBlock FontWeight="SemiBold" Text="상태" />
                <TextBlock Margin="12,0,0,0" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="가구 목록" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.76"
                                   Text="패치 가능한 콘텐츠가 될 가구 프리셋을 관리합니다." />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Padding="12,7" Click="AddItem_Click" Content="추가" />
                        <Button Margin="0,0,8,0" Padding="12,7" Click="CloneItem_Click" Content="복제" />
                        <Button Padding="12,7" Click="DeleteItem_Click" Content="삭제" />
                    </StackPanel>

                    <ListBox BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FurnitureItemDto}">
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Code}" />
                                        <TextBlock Margin="0,4,0,0" Opacity="0.84" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Opacity="0.72"
                                                   Text="{Binding PrefabSourcePath}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Opacity="0.72"
                                                   Text="{Binding Defects.Count, StringFormat=Defects: {0}건}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="매니페스트 및 항목 상세" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.76"
                                   Text="패치 메타데이터와 현재 선택된 가구 항목을 편집합니다." />

                        <GroupBox Margin="0,18,0,0" Header="매니페스트">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Text="매니페스트 버전" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding CurrentManifest.ManifestVersion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Text="카탈로그 버전" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding CurrentManifest.CatalogVersion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Text="작성자" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding CurrentManifest.Author, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Text="생성 시각" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding CurrentManifest.CreatedAt, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,18,0,0" Header="Unity 배치 빌드 설정">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Margin="0,0,0,6" Text="Unity Editor 실행 파일" />
                                    <DockPanel>
                                        <TextBox Padding="10,8"
                                                 Text="{Binding UnityEditorPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="8,0,0,0"
                                                Padding="10,8"
                                                DockPanel.Dock="Right"
                                                Click="BrowseUnityEditor_Click"
                                                Content="찾아보기" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="Unity 프로젝트 경로" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding UnityProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,18,0,0" Header="선택 항목">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Text="Code" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding SelectedItem.Code, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Text="표시 이름" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="출력 코드" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding SelectedItem.ExportCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="네이티브 코드" />
                                    <TextBox Padding="10,8"
                                             Text="{Binding SelectedItem.NativeCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="프리팹 원본 경로" />
                                    <DockPanel>
                                        <TextBox Padding="10,8"
                                                 Text="{Binding SelectedItem.PrefabSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="8,0,0,0"
                                                Padding="10,8"
                                                DockPanel.Dock="Right"
                                                Click="BrowsePrefab_Click"
                                                Content="찾아보기" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="썸네일 원본 경로" />
                                    <DockPanel>
                                        <TextBox Padding="10,8"
                                                 Text="{Binding SelectedItem.ThumbnailSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="8,0,0,0"
                                                Padding="10,8"
                                                DockPanel.Dock="Right"
                                                Click="BrowseThumbnail_Click"
                                                Content="찾아보기" />
                                    </DockPanel>
                                </StackPanel>

                                <UniformGrid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,18,0,0" Columns="3">
                                    <GroupBox Margin="0,0,10,0" Header="배치 오프셋">
                                        <StackPanel Margin="10">
                                            <TextBlock Opacity="0.7" Text="X / Y / Z" />
                                            <TextBox Margin="0,8,0,8" Padding="8,6" Text="{Binding SelectedItem.PlacementOffset.X, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,0,0,8" Padding="8,6" Text="{Binding SelectedItem.PlacementOffset.Y, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Padding="8,6" Text="{Binding SelectedItem.PlacementOffset.Z, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Margin="0,0,10,0" Header="기본 오일러 각도">
                                        <StackPanel Margin="10">
                                            <TextBlock Opacity="0.7" Text="X / Y / Z" />
                                            <TextBox Margin="0,8,0,8" Padding="8,6" Text="{Binding SelectedItem.DefaultEulerAngles.X, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,0,0,8" Padding="8,6" Text="{Binding SelectedItem.DefaultEulerAngles.Y, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Padding="8,6" Text="{Binding SelectedItem.DefaultEulerAngles.Z, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="바운드 크기">
                                        <StackPanel Margin="10">
                                            <TextBlock Opacity="0.7" Text="X / Y / Z" />
                                            <TextBox Margin="0,8,0,8" Padding="8,6" Text="{Binding SelectedItem.BoundsSize.X, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,0,0,8" Padding="8,6" Text="{Binding SelectedItem.BoundsSize.Y, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Padding="8,6" Text="{Binding SelectedItem.BoundsSize.Z, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </GroupBox>
                                </UniformGrid>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4"
                    Padding="18"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Defects" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.76"
                                   Text="선택된 가구 항목의 mntnCd / locCd / mtrlCd 행을 관리합니다." />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Padding="12,7" Click="AddDefect_Click" Content="행 추가" />
                        <Button Padding="12,7" Click="DeleteDefect_Click" Content="행 삭제" />
                    </StackPanel>
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding SelectedItem.Defects}"
                              SelectedItem="{Binding SelectedDefect}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding MntnCd, UpdateSourceTrigger=PropertyChanged}" Header="mntnCd" />
                            <DataGridTextColumn Width="*" Binding="{Binding LocCd, UpdateSourceTrigger=PropertyChanged}" Header="locCd" />
                            <DataGridTextColumn Width="*" Binding="{Binding MtrlCd, UpdateSourceTrigger=PropertyChanged}" Header="mtrlCd" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
